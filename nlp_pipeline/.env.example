# nlp_pipeline/.env — NEVER commit this file!
# Copy this file to .env and fill in values.

CLAUDE_API_KEY=
OPENAI_API_KEY=
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
CHROMA_PERSIST_DIR=./chroma_db
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Embedding model (multilingual for Indonesian text)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2

# Chunking
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# LLM tuning
LLM_TEMPERATURE_ANALYSIS=0.1
LLM_TEMPERATURE_CHAT=0.3
LLM_MAX_TOKENS_ANALYSIS=8192
LLM_TIMEOUT_SECONDS=120

# Retrieval
RETRIEVAL_TOP_K=8
