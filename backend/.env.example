# backend/.env — NEVER commit this file!
# Copy this file to .env and fill in values.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/legaleasier
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
CLAUDE_API_KEY=
OPENAI_API_KEY=
SECRET_KEY=change-me-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
NLP_SERVICE_URL=http://localhost:8001

# MinIO / S3 object storage (shared miniatur-cloud service)
# Set USE_S3_STORAGE=false to fall back to PostgreSQL bytea storage
USE_S3_STORAGE=false
MINIO_ENDPOINT=170.30.0.1:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=CloudPass2024!
MINIO_BUCKET_NAME=legaleasier-documents
MINIO_SECURE=false
